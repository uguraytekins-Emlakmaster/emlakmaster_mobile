# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  # Üçüncü parti Pod kaynaklarını elle değiştirmeden (pod install sonrası silinir) derleyici
  # uyarılarını azaltır: Firebase, file_picker, cloud_* vb. deprecation / tip uyarıları.
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Köklü gürültü azaltma: Pod kaynaklarını elle düzeltmeden (firebase_*, file_picker, …)
      # deprecation / implicit cast / uyumsuz tip uyarılarını derleme aşamasında bastırır.
      # Gerçek API güncellemesi ayrıca pubspec + plugin major yükseltmesiyle yapılmalı.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['GCC_WARN_DEPRECATED_DECLARATIONS'] = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
      flags = flags.is_a?(Array) ? flags.join(' ') : flags.to_s
      unless flags.include?('suppress-warnings')
        config.build_settings['OTHER_SWIFT_FLAGS'] = "#{flags} -suppress-warnings".strip
      end
    end

    # Xcode 14+: "Run script … will run during every build because it does not specify any outputs"
    # for gRPC / abseil / BoringSSL / FirebaseCrashlytics "Create Symlinks to Header Folders".
    # Append a DerivedData stamp + declare outputPaths (idempotent; no pod source edits).
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name) && phase.name == 'Create Symlinks to Header Folders'
      next unless phase.respond_to?(:shell_script) && phase.respond_to?(:output_paths)

      marker = '# EmlakMaster symlink stamp output'
      script = phase.shell_script || ''
      next if script.include?(marker)

      stamp_file = "Pods-#{target.name.gsub(/[^A-Za-z0-9._-]/, '_')}-symlink_headers.stamp"
      stamp_out = "$(DERIVED_FILE_DIR)/#{stamp_file}"
      phase.output_paths ||= []
      phase.output_paths << stamp_out unless phase.output_paths.include?(stamp_out)

      phase.shell_script = <<~SCRIPT
        #{script.rstrip}
        #{marker}
        mkdir -p "${DERIVED_FILE_DIR}"
        : > "${DERIVED_FILE_DIR}/#{stamp_file}"
      SCRIPT
    end
  end
end
